---
import {Image} from "astro:assets";
import {projects} from "../data/portfolio";

const featured = projects.filter(p => p.featured);
const rest = projects.filter(p => !p.featured);
---

<section id="projects">
  <div class="kicker">Things I've built</div>
  <h2>Projects</h2>

  <div class="featured">
    {featured.map(p => (
      <a
        class="card project"
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="shot">
          {p.image ? (
            <Image
              src={p.image}
              alt=""
              width={520}
              height={240}
              densities={[1, 2]}
            />
          ) : (
            <span>PROJECT SCREENSHOT</span>
          )}
        </div>
        <div class="body">
          <h3>{p.name}</h3>
          <p>{p.description}</p>
          {p.tags && (
            <ul class="chips">
              {p.tags.map(t => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </div>
      </a>
    ))}
  </div>

  <div class="grid">
    {rest.map(p => (
      <a
        class="card project small"
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="body">
          <div class="icon" aria-hidden="true">
            {p.icon}
          </div>
          <h3>{p.name}</h3>
          <p>{p.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .project {
    display: block;
  }
  .project:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--a-rgb), 0.55);
    box-shadow: 0 0 40px -16px rgba(var(--g-rgb), 0.7);
  }
  .shot {
    height: 200px;
    background:
      radial-gradient(
        circle at 30% 40%,
        rgba(var(--g-rgb), 0.45),
        transparent 55%
      ),
      var(--card2);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--dim);
    letter-spacing: 0.12em;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 20px 22px;
  }
  h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: var(--text);
  }
  p {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }
  .body .chips {
    margin-top: 12px;
  }
  .small h3 {
    font-size: 17px;
  }
  .small p {
    font-size: 14px;
  }
  .icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--card2);
    border: 1px solid var(--line2);
    display: grid;
    place-items: center;
    font-size: 16px;
    margin-bottom: 12px;
    color: var(--al);
  }
  @media (max-width: 820px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
