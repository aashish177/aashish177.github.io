---
import {Image} from "astro:assets";
import {profile, status} from "../data/portfolio";
---

<section class="hero" id="top">
  <div>
    <p class="status">
      <span class="dot"></span>
      {status.pill}
    </p>
    <h1>
      {profile.headline.map(line => (
        <>
          {line}
          <br />
        </>
      ))}
      <span class="ac">{profile.headlineAccent}</span>
    </h1>
    <p class="sub">{profile.intro}</p>
    <div class="btns">
      <a class="b1" href="#projects">
        View projects ↓
      </a>
      <a
        class="b2"
        href={profile.resume}
        target="_blank"
        rel="noopener noreferrer"
      >
        Resume
      </a>
    </div>
  </div>
  <div class="photo">
    <Image
      src={profile.photo}
      alt={profile.name}
      width={440}
      height={440}
      densities={[1, 2]}
      priority
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: calc(100vh - 70px);
    padding: 40px 0 60px;
  }
  .status {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    margin: 0;
  }
  h1 {
    font-size: clamp(42px, 5vw, 84px);
    line-height: 1.02;
    margin: 20px 0 18px;
    letter-spacing: -0.025em;
  }
  .sub {
    font-size: clamp(16px, 1.3vw, 21px);
    color: var(--muted);
    max-width: 34em;
    line-height: 1.6;
    margin: 0;
  }
  .btns {
    display: flex;
    gap: 12px;
    margin-top: 30px;
  }
  .b1,
  .b2 {
    font-size: 15px;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 12px;
  }
  .b1 {
    background: var(--text);
    color: var(--bg);
    box-shadow: 0 10px 28px -14px rgba(var(--g-rgb), 0.8);
  }
  .b2 {
    border: 1px solid var(--line2);
    color: var(--text);
    background: var(--card);
  }
  .photo {
    position: relative;
    justify-self: center;
    width: clamp(240px, 26vw, 440px);
    aspect-ratio: 1;
  }
  .photo::before {
    content: "";
    position: absolute;
    inset: -40px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(var(--g-rgb), 0.55),
      transparent 65%
    );
    filter: blur(10px);
    animation: breathe 5s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    to {
      opacity: 0.6;
      transform: scale(1.05);
    }
  }
  .photo img {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
    border: 3px solid var(--a);
    box-shadow: 0 0 0 10px rgba(var(--g-rgb), 0.12);
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 24px;
    }
    .photo {
      grid-row: 1;
      justify-self: start;
      width: 200px;
    }
  }
</style>
