---
import {Image} from "astro:assets";
import {certifications} from "../data/portfolio";
---

<section id="certs">
  <div class="kicker">Verified</div>
  <h2>
    AWS <span class="ac">Certifications</span>
  </h2>
  <div class="grid">
    {certifications.map(c => (
      <article class="card ring cert">
        <Image
          class="badge"
          src={c.badge}
          alt={`AWS Certified ${c.name} – ${c.level} badge`}
          width={96}
          height={96}
          densities={[1, 2]}
        />
        <div>
          <h3>{c.name}</h3>
          <div class="level">{c.level}</div>
          <p>{c.description}</p>
          <a href={c.url} target="_blank" rel="noopener noreferrer">
            Verify on Credly ↗
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .cert {
    padding: 30px;
    display: flex;
    gap: 22px;
  }
  .badge {
    flex: none;
    width: 96px;
    height: 96px;
    object-fit: contain;
    filter: drop-shadow(0 6px 18px rgba(var(--g-rgb), 0.35));
  }
  h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 2px;
  }
  .level {
    font-size: 12px;
    font-weight: 700;
    color: var(--al);
    margin-bottom: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }
  a {
    display: inline-block;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 700;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
