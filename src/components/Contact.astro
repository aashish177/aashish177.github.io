---
import {profile} from "../data/portfolio";
---

<section id="contact" class="contact">
  <div class="kicker">Contact</div>
  <h2>
    Let's build
    <br />
    <span class="ac">something.</span>
  </h2>
  <p>{profile.openTo}</p>
  <div class="mail">
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    <button id="copy-email" data-email={profile.email}>
      Copy
    </button>
  </div>
  <div class="social">
    <a href={profile.github} target="_blank" rel="noopener noreferrer">
      GitHub
    </a>
    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
      LinkedIn
    </a>
    <a href={profile.resume} target="_blank" rel="noopener noreferrer">
      Resume ↗
    </a>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-email");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email ?? "");
      btn.textContent = "Copied ✓";
    } catch {
      btn.textContent = "Copy failed";
    }
    setTimeout(() => (btn.textContent = "Copy"), 1600);
  });
</script>

<style>
  .contact {
    text-align: center;
    padding: 140px 0 110px;
  }
  .contact::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 640px;
    max-width: 100%;
    height: 360px;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, var(--glow), transparent);
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
  }
  h2 {
    font-size: clamp(42px, 5vw, 84px);
    line-height: 1.02;
    margin: 0 0 14px;
  }
  p {
    font-size: 17px;
    color: var(--muted);
    margin: 0 0 30px;
  }
  .mail {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    background: var(--card);
    border: 1px solid rgba(108, 99, 255, 0.55);
    border-radius: 16px;
    padding: 7px 7px 7px 20px;
    box-shadow: 0 0 44px -14px rgba(108, 99, 255, 0.8);
  }
  .mail a {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
  }
  .mail button {
    font: 700 14px var(--body);
    background: var(--a);
    color: #fff;
    border: 0;
    border-radius: 11px;
    padding: 10px 16px;
    cursor: pointer;
  }
  .social {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 26px;
  }
  .social a {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--line2);
    border-radius: 11px;
    padding: 9px 16px;
  }
  .social a:hover {
    border-color: var(--a);
  }
  @media (max-width: 820px) {
    .contact {
      padding: 100px 0 80px;
    }
    .mail {
      flex-wrap: wrap;
      justify-content: center;
    }
    .mail a {
      font-size: 14px;
    }
  }
</style>
