---
import type {CaseStudy} from "../../data/showcase";

interface Props {
  replay: CaseStudy["replay"];
  steps: CaseStudy["pipeline"];
}

const {replay, steps} = Astro.props;
const names = Object.fromEntries(steps.map(s => [s.id, s.name]));
---

<div class="card replay" data-replay={JSON.stringify(replay.events)}>
  <div class="head">
    <div>
      <div class="kicker">Recorded run</div>
      <div class="topic">{replay.topic}</div>
    </div>
    <div class="controls">
      {replay.sample && <span class="badge">Sample data</span>}
      <button type="button" class="play" data-play>
        Replay
      </button>
    </div>
  </div>

  <div class="grid">
    <ol class="trace">
      {steps.map(s => (
        <li>
          <button type="button" class="item" data-agent={s.id} disabled>
            <span class="dot-state" aria-hidden="true"></span>
            <span class="label">
              <span class="name">{names[s.id]}</span>
              <span class="sub">Waiting</span>
            </span>
            <span class="meta"></span>
          </button>
        </li>
      ))}
    </ol>
    <div class="detail" data-detail aria-live="polite">
      <p class="muted">Press Replay to watch the agents run.</p>
    </div>
  </div>
  <div class="totals" data-totals></div>
</div>

<script>
  type Ev = {
    agent: string;
    at: number;
    summary: string;
    duration?: number;
    tokens?: number;
    cost?: number;
    details?: {label: string; items: string[]}[];
  };

  // Replays a stored run: no backend calls, so it costs nothing and can't be abused.
  for (const root of document.querySelectorAll<HTMLElement>("[data-replay]")) {
    const events: Ev[] = JSON.parse(root.dataset.replay || "[]");
    const playBtn = root.querySelector<HTMLButtonElement>("[data-play]")!;
    const detail = root.querySelector<HTMLElement>("[data-detail]")!;
    const totals = root.querySelector<HTMLElement>("[data-totals]")!;
    const items = new Map(
      [...root.querySelectorAll<HTMLButtonElement>("[data-agent]")].map(b => [
        b.dataset.agent!,
        b
      ])
    );
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timers: number[] = [];

    const show = (ev: Ev) => {
      items.forEach(b =>
        b.classList.toggle("sel", b.dataset.agent === ev.agent)
      );
      detail.replaceChildren();
      const h = document.createElement("h4");
      h.textContent =
        items.get(ev.agent)?.querySelector(".name")?.textContent || ev.agent;
      const p = document.createElement("p");
      p.className = "muted";
      p.textContent = ev.summary;
      detail.append(h, p);
      for (const d of ev.details || []) {
        const lbl = document.createElement("div");
        lbl.className = "lbl";
        lbl.textContent = d.label;
        const ul = document.createElement("ul");
        for (const it of d.items) {
          const li = document.createElement("li");
          li.textContent = it;
          ul.append(li);
        }
        detail.append(lbl, ul);
      }
    };

    const finish = (ev: Ev) => {
      const b = items.get(ev.agent);
      if (!b) return;
      b.classList.remove("run");
      b.classList.add("done");
      b.disabled = false;
      b.querySelector(".sub")!.textContent = ev.summary;
      b.querySelector(".meta")!.textContent = [
        ev.duration != null ? `${ev.duration.toFixed(1)}s` : "",
        ev.tokens != null ? `${ev.tokens.toLocaleString()} tok` : ""
      ]
        .filter(Boolean)
        .join(" · ");
      b.onclick = () => show(ev);
      show(ev);
    };

    const summarize = () => {
      const time = Math.max(...events.map(e => e.at + (e.duration || 0)));
      const tokens = events.reduce((a, e) => a + (e.tokens || 0), 0);
      totals.textContent = `Wall time ${time.toFixed(1)}s · ${tokens.toLocaleString()} tokens`;
    };

    const reset = () => {
      timers.forEach(clearTimeout);
      timers = [];
      totals.textContent = "";
      items.forEach(b => {
        b.className = "item";
        b.disabled = true;
        b.querySelector(".sub")!.textContent = "Waiting";
        b.querySelector(".meta")!.textContent = "";
      });
    };

    const play = () => {
      reset();
      if (reduced) {
        events.forEach(finish);
        summarize();
        return;
      }
      // Compress the real timeline so a full run replays in about 8 seconds.
      const end = Math.max(...events.map(e => e.at + (e.duration || 0))) || 1;
      const scale = 8000 / end;
      for (const ev of events) {
        timers.push(
          window.setTimeout(
            () => items.get(ev.agent)?.classList.add("run"),
            ev.at * scale
          )
        );
        timers.push(
          window.setTimeout(
            () => finish(ev),
            (ev.at + (ev.duration || 0)) * scale
          )
        );
      }
      timers.push(window.setTimeout(summarize, end * scale + 50));
    };

    playBtn.addEventListener("click", play);
  }
</script>

<style>
  .replay {
    padding: 24px 26px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
  }
  .head .kicker {
    margin: 0;
  }
  .topic {
    font-family: var(--display);
    font-size: 20px;
    color: var(--text);
  }
  .controls {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .badge {
    font-size: 12px;
    color: var(--ac);
    border: 1px solid var(--ac);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .play {
    font: inherit;
    font-size: 14px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--a);
    background: var(--a);
    color: var(--bg);
    cursor: pointer;
  }
  .grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 20px;
  }
  .trace {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .item {
    width: 100%;
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 10px;
    align-items: start;
    text-align: left;
    font: inherit;
    background: none;
    border: 0;
    border-radius: 12px;
    padding: 9px 10px;
    color: var(--text);
    cursor: pointer;
  }
  .item:disabled {
    cursor: default;
  }
  .item.sel {
    background: var(--card2);
  }
  .dot-state {
    width: 9px;
    height: 9px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--line2);
  }
  .item.run .dot-state {
    background: var(--ac);
    box-shadow: 0 0 0 4px rgba(var(--g-rgb), 0.3);
  }
  .item.done .dot-state {
    background: #2f9e6a;
  }
  .label {
    display: grid;
  }
  .name {
    font-weight: 700;
    font-size: 14.5px;
  }
  .sub {
    font-size: 13px;
    color: var(--dim);
  }
  .meta {
    font-size: 12.5px;
    color: var(--dim);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .detail {
    background: var(--card2);
    border-radius: 14px;
    padding: 16px 18px;
    min-height: 220px;
    color: var(--text);
  }
  .detail :global(h4) {
    margin: 0 0 4px;
    font-family: var(--display);
    font-size: 18px;
  }
  .detail :global(.muted) {
    color: var(--muted);
    margin: 0;
  }
  .detail :global(.lbl) {
    margin: 14px 0 6px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .detail :global(ul) {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
  }
  .totals {
    margin-top: 14px;
    font-size: 13.5px;
    color: var(--dim);
    min-height: 1.4em;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
