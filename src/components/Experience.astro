---
import {Image} from "astro:assets";
import {experience} from "../data/portfolio";
---

<section id="experience">
  <div class="kicker">Where I've worked</div>
  <h2>Experience</h2>
  <ol class="timeline" id="timeline">
    {experience.map((role, i) => (
      <li class:list={["item", {featured: role.featured}]} style={`--i: ${i}`}>
        <span class="node" aria-hidden="true">
          <Image
            src={role.logo}
            alt=""
            width={44}
            height={44}
            densities={[1, 2]}
            fit="contain"
          />
        </span>
        <details open={role.featured}>
          <summary>
            <div>
              <div class="role">
                {role.title}
                {!role.end && (
                  <span class="badge">
                    <span class="dot" />
                    Now
                  </span>
                )}
              </div>
              <div class="company">
                <span class:list={{amz: role.featured}}>{role.company}</span>
                {role.team && ` · ${role.team}`}
              </div>
            </div>
            <div class="dates">
              {role.start} – {role.end ?? "now"}
              <span aria-hidden="true">+</span>
            </div>
          </summary>
          <ul class="bullets">
            {role.bullets.map(b => (
              <li>{b}</li>
            ))}
          </ul>
          {role.tags && (
            <ul class="chips">
              {role.tags.map(t => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </details>
      </li>
    ))}
  </ol>
</section>

<script>
  // Hide items until the section scrolls into view, then draw the line.
  const tl = document.getElementById("timeline");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (tl && !reduced && "IntersectionObserver" in window) {
    tl.classList.add("armed");
    const io = new IntersectionObserver(
      entries => {
        if (entries.some(e => e.isIntersecting)) {
          tl.classList.add("play");
          io.disconnect();
        }
      },
      {threshold: 0.2}
    );
    io.observe(tl);
  }
</script>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 66px;
  }
  .item {
    position: relative;
  }
  .item::before {
    content: "";
    position: absolute;
    left: -45px;
    top: 52px;
    bottom: -10px;
    width: 2px;
    background: var(--a);
    border-radius: 2px;
    transform-origin: top;
  }
  .item:last-child::before {
    display: none;
  }
  .featured::before {
    background: var(--orange);
  }
  .node {
    position: absolute;
    left: -66px;
    top: 10px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--a);
    box-shadow: 0 0 0 4px var(--bg);
    display: grid;
    place-items: center;
    z-index: 1;
  }
  .node img {
    width: 72%;
    height: 72%;
    object-fit: contain;
    border-radius: 50%;
  }
  .featured .node {
    border-color: var(--orange);
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 0 8px rgba(245, 158, 11, 0.15),
      0 0 20px var(--orange);
  }
  .featured .node::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--orange);
    animation: pulse 1.8s ease-out infinite;
  }
  @keyframes pulse {
    from {
      opacity: 0.8;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.4);
    }
  }
  details {
    border-bottom: 1px solid var(--line);
    padding: 16px 4px 16px 0;
  }
  .item:last-child details {
    border-bottom: 0;
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: baseline;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .role {
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .featured .role {
    font-size: 23px;
  }
  .company {
    font-size: 14px;
    color: var(--muted);
    margin-top: 3px;
  }
  .amz {
    color: var(--orange);
    font-weight: 700;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--body);
    font-size: 11px;
    font-weight: 700;
    color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 2px 9px;
    border-radius: 999px;
    margin-left: 10px;
    vertical-align: 3px;
  }
  .badge .dot {
    width: 6px;
    height: 6px;
  }
  .dates {
    font-size: 13px;
    font-weight: 700;
    color: var(--al);
    white-space: nowrap;
  }
  .dates span {
    display: inline-block;
    margin-left: 8px;
    color: var(--dim);
    font-size: 16px;
    transition: transform 0.2s;
  }
  details[open] .dates span {
    transform: rotate(45deg);
  }
  .bullets {
    margin: 12px 0 2px;
    padding-left: 18px;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 62em;
  }
  .chips {
    margin-top: 14px;
  }

  .armed .item {
    opacity: 0;
  }
  .armed .item::before {
    transform: scaleY(0);
  }
  .armed.play .item {
    animation: slide-in 0.45s ease-out forwards;
    animation-delay: calc(var(--i) * 0.35s);
  }
  .armed.play .item::before {
    animation: grow 0.4s ease-out forwards;
    animation-delay: calc(var(--i) * 0.35s + 0.2s);
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes grow {
    to {
      transform: scaleY(1);
    }
  }

  @media (max-width: 820px) {
    .timeline {
      padding-left: 52px;
    }
    .item::before {
      left: -36px;
      top: 46px;
    }
    .node {
      left: -52px;
      width: 34px;
      height: 34px;
    }
    summary {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .dates span {
      display: none;
    }
  }
</style>
