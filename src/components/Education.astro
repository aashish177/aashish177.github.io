---
import {Image} from "astro:assets";
import {education} from "../data/portfolio";
---

<section id="education">
  <div class="kicker">Background</div>
  <h2>Education</h2>
  <div class="card ring edu">
    <div class="row">
      <div class="logo-tile">
        <Image
          src={education.logo}
          alt=""
          width={64}
          height={64}
          fit="contain"
        />
      </div>
      <div>
        <h3>{education.degree}</h3>
        <div class="school">{education.school}</div>
        <div class="honors">
          <span class="gpa">GPA {education.gpa}</span>
          <span class="award">★ {education.award}</span>
        </div>
      </div>
      <div class="dates">
        {education.dates}
        <span>{education.note}</span>
      </div>
    </div>
    <div class="label">Coursework</div>
    <ul class="chips">
      {education.coursework.map(c => (
        <li>{c}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .edu {
    padding: 28px;
  }
  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 18px;
    align-items: start;
  }
  .row .logo-tile {
    width: 60px;
    height: 60px;
    border-radius: 16px;
  }
  h3 {
    font-size: 23px;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .school {
    font-size: 14px;
    color: var(--muted);
    margin-top: 2px;
  }
  .honors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .gpa {
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: var(--a);
    padding: 4px 11px;
    border-radius: 999px;
  }
  .award {
    display: inline-flex;
    font-size: 12px;
    font-weight: 700;
    color: #1a1205;
    background: var(--orange);
    padding: 4px 11px;
    border-radius: 999px;
  }
  .dates {
    font-size: 13px;
    font-weight: 700;
    color: var(--al);
    text-align: right;
    white-space: nowrap;
  }
  .dates span {
    display: block;
    color: var(--dim);
    font-weight: 500;
  }
  .label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 22px 0 10px;
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: auto 1fr;
    }
    .dates {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
