---
import Base from "../../layouts/Base.astro";
import FlowSpine from "../../components/showcase/FlowSpine.astro";
import RunReplay from "../../components/showcase/RunReplay.astro";
import {caseStudies, type CaseStudy} from "../../data/showcase";

// Unpublished studies build only when previewing: SHOWCASE_PREVIEW=1 npm run dev
export function getStaticPaths() {
  const preview = process.env.SHOWCASE_PREVIEW === "1";
  return caseStudies
    .filter(s => s.published || preview)
    .map(study => ({params: {slug: study.slug}, props: {study}}));
}

interface Props {
  study: CaseStudy;
}

const {study} = Astro.props;
---

<Base title={`${study.name} | Aashish Maharjan`} description={study.tagline}>
  <header class="top wrap">
    <a class="brand" href="/">
      Aashish<span class="ac">.</span>
    </a>
    <div class="right">
      <a href="/#projects">All projects</a>
      <button
        class="tg"
        id="theme-toggle"
        aria-label="Toggle light and dark theme"
      >
        ◐
      </button>
    </div>
  </header>

  <main class="wrap cs" id="main">
    {!study.published && <p class="draft">Draft preview — not published</p>}

    <section class="hero">
      <div class="kicker">Case study</div>
      <h1>{study.name}</h1>
      <p class="lede">{study.tagline}</p>
      <p class="summary">{study.summary}</p>
      <ul class="metrics">
        {study.metrics.map(m => (
          <li>
            <strong>{m.value}</strong>
            <span>{m.label}</span>
          </li>
        ))}
      </ul>
      <div class="actions">
        {study.links.demo && (
          <a
            class="btn primary"
            href={study.links.demo}
            target="_blank"
            rel="noopener noreferrer"
          >
            Try the live demo
          </a>
        )}
        <a
          class="btn"
          href={study.links.repo}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
      </div>
      <ul class="chips">
        {study.tags.map(t => (
          <li>{t}</li>
        ))}
      </ul>
    </section>

    <section>
      <div class="kicker">See it work</div>
      <h2>A real run, replayed</h2>
      <RunReplay replay={study.replay} steps={study.pipeline} />
    </section>

    <section class="two">
      <div>
        <div class="kicker">The problem</div>
        <h2>Why it exists</h2>
        {study.problem.map(p => (
          <p class="text">{p}</p>
        ))}
      </div>
      <div>
        <div class="kicker">How it works</div>
        <h2>Eight agents, one pipeline</h2>
        <FlowSpine steps={study.pipeline} />
      </div>
    </section>

    <section>
      <div class="kicker">On AWS</div>
      <h2>Architecture</h2>
      <!-- TODO: swap for the final AWS diagram once deployed. -->
      <FlowSpine steps={study.architecture} />
    </section>

    <section>
      <div class="kicker">Engineering</div>
      <h2>Decisions that mattered</h2>
      <div class="decisions">
        {study.decisions.map(d => (
          <article class="card decision">
            <h3>{d.title}</h3>
            <p class="problem">{d.problem}</p>
            <p>{d.choice}</p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <div class="kicker">Results</div>
      <h2>Measured in production</h2>
      <table class="results">
        <tbody>
          {study.results.map(r => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{r.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <div class="kicker">Next</div>
      <h2>What I'd build next</h2>
      <ul class="next">
        {study.next.map(n => (
          <li>{n}</li>
        ))}
      </ul>
    </section>

    <footer class="foot">
      <a href="/#projects">← Back to all projects</a>
    </footer>
  </main>
</Base>

<script>
  const root = document.documentElement;
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = root.dataset.theme === "light" ? "dark" : "light";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    position: relative;
    z-index: 2;
  }
  .brand {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    color: var(--text);
  }
  .right {
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 14.5px;
  }
  .right a {
    color: var(--muted);
  }
  .tg {
    font: inherit;
    background: none;
    border: 1px solid var(--line2);
    border-radius: 999px;
    width: 34px;
    height: 34px;
    color: var(--text);
    cursor: pointer;
  }
  .cs {
    max-width: 1080px;
    padding-bottom: 96px;
  }
  .draft {
    display: inline-block;
    margin: 0;
    padding: 4px 12px;
    border: 1px dashed var(--ac);
    border-radius: 999px;
    color: var(--ac);
    font-size: 13px;
  }
  .hero {
    padding-top: 40px;
  }
  h1 {
    font-size: clamp(44px, 6vw, 84px);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }
  .lede {
    font-size: clamp(19px, 1.6vw, 24px);
    color: var(--text);
    margin: 0 0 12px;
    max-width: 760px;
  }
  .summary,
  .text {
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.65;
    max-width: 720px;
    margin: 0 0 14px;
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    list-style: none;
    padding: 0;
    margin: 28px 0;
  }
  .metrics strong {
    display: block;
    font-family: var(--display);
    font-size: 36px;
    color: var(--text);
  }
  .metrics span {
    color: var(--dim);
    font-size: 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
  }
  .btn {
    padding: 10px 18px;
    border: 1px solid var(--line2);
    border-radius: 999px;
    color: var(--text);
    font-size: 15px;
  }
  .btn.primary {
    background: var(--a);
    border-color: var(--a);
    color: var(--bg);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
  }
  .decisions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .decision {
    padding: 20px 22px;
  }
  .decision h3 {
    margin: 0 0 8px;
    font-size: 19px;
  }
  .decision p {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
    font-size: 14.5px;
  }
  .decision .problem {
    color: var(--dim);
    margin-bottom: 8px;
  }
  .results {
    width: 100%;
    max-width: 640px;
    border-collapse: collapse;
  }
  .results th,
  .results td {
    text-align: left;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15.5px;
  }
  .results th {
    color: var(--muted);
    font-weight: 500;
  }
  .results td {
    font-family: var(--display);
    color: var(--text);
  }
  .next {
    color: var(--muted);
    line-height: 1.8;
    padding-left: 20px;
    margin: 0;
  }
  .foot {
    padding-top: 64px;
  }
  @media (max-width: 820px) {
    .two,
    .decisions {
      grid-template-columns: 1fr;
    }
  }
</style>
